<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- TC_Identity: target for simple leaf-op tests (CASE 1 — add/replace on an exact defName
       xpath). Should always appear dirty when TestMod_Change's patch for it changes. -->
  <ThingDef>
    <defName>TC_Identity</defName>
    <label>test identity</label>
  </ThingDef>

  <!-- TC_SeqSibling: co-patched alongside TC_SeqTarget inside TestMod_Static's sequence
       (CASE 3). When TC_SeqTarget is dirty, TC_SeqSibling must be present in any
       recompute sub-doc so the sequence doesn't abort before reaching TC_SeqTarget's op.
       TC_SeqSibling itself is not independently dirty — it's a passive context def. -->
  <ThingDef>
    <defName>TC_SeqSibling</defName>
    <label>test seq sibling</label>
  </ThingDef>

  <!-- TC_SeqTarget: the def made dirty by TestMod_Change (CASE 3). TestMod_Static's
       PatchOperationSequence targets it in the same sequence as TC_SeqSibling, so both
       must be in the recompute sub-doc for the sequence to complete successfully. -->
  <ThingDef>
    <defName>TC_SeqTarget</defName>
    <label>test seq target</label>
  </ThingDef>

  <!-- TC_Conditional: used by TestMod_Static's PatchOperationConditional (CASE 5).
       Run A: no conditionalTrigger field → nomatch branch taken → conditionalNoMatchTag added.
       Run B: TestMod_Change adds conditionalTrigger → match branch taken → conditionalMatchTag
       added instead. The def is dirty in run B because its patch file changed. -->
  <ThingDef>
    <defName>TC_Conditional</defName>
    <label>test conditional</label>
  </ThingDef>

  <!-- TC_WildcardBase / TC_Wildcard_A/B/C: for the xpath-widen (wildcard flip) test
       (CASES 2 & 4). The abstract base carries the @Name="TC_WildcardBase" attribute that
       the run-B patch uses as @ParentName="TC_WildcardBase" to wildcard-match all three
       concrete children at once — widening from the narrow run-A patch that only targets
       TC_Wildcard_A by defName. -->
  <ThingDef Abstract="True" Name="TC_WildcardBase">
    <label>wildcard base</label>
  </ThingDef>

  <ThingDef ParentName="TC_WildcardBase">
    <defName>TC_Wildcard_A</defName>
    <label>wildcard a</label>
  </ThingDef>

  <ThingDef ParentName="TC_WildcardBase">
    <defName>TC_Wildcard_B</defName>
    <label>wildcard b</label>
  </ThingDef>

  <ThingDef ParentName="TC_WildcardBase">
    <defName>TC_Wildcard_C</defName>
    <label>wildcard c</label>
  </ThingDef>

  <!-- CASE 6: cross-def conditional (recompute-fidelity gap probe).
       TC_CrossProbe is a passive, never-dirty def whose <probeFlag> is the TEST target of
       TestMod_Static's cross-def PatchOperationConditional. The conditional's EFFECT lands on
       TC_CrossEffect (a different def). When the expect-recompute-gap mode dirties TC_CrossEffect (via
       TestMod_Change), the recompute sub-doc contains TC_CrossEffect but NOT TC_CrossProbe (it
       is neither dirty nor a sequence sibling, so SubDocExpander never pulls it in). The
       conditional therefore re-evaluates its test against an absent probe and takes the WRONG
       branch — reproducing a genuine cross-def recompute-fidelity gap the full rebuild does not
       have. In every OTHER mode TC_CrossEffect is never dirtied, so this whole case is inert. -->
  <ThingDef>
    <defName>TC_CrossProbe</defName>
    <label>test cross probe</label>
    <probeFlag>yes</probeFlag>
  </ThingDef>

  <ThingDef>
    <defName>TC_CrossEffect</defName>
    <label>test cross effect</label>
  </ThingDef>

  <!-- CASE 7: nested conditional (RecomputeAllowlist.BranchParentId regression, issue #25 / PR #37).
       TC_NestedTarget is dirtied directly by TestMod_Change (a plain leaf op, same mechanism as
       TC_CrossEffect in CASE 6). TestMod_Static's OUTER conditional tests TC_NestedTarget itself
       (same-def, in sub-doc); its match branch is an INNER conditional whose test is on
       TC_NestedProbe (cross-def, never dirty). The bug: BranchParentId used to cut a branch child's
       id at the FIRST ".match"/".nomatch" segment, resolving the inner leaf's gating parent to the
       OUTER (same-def) conditional instead of the INNER (cross-def) one — wrongly admitting a
       recompute that a sub-doc lacking TC_NestedProbe would silently get wrong. -->
  <ThingDef>
    <defName>TC_NestedTarget</defName>
    <label>test nested target</label>
  </ThingDef>

  <ThingDef>
    <defName>TC_NestedProbe</defName>
    <label>test nested probe</label>
    <probeFlag>yes</probeFlag>
  </ThingDef>

  <!-- CASE 8: conditional nested inside a PatchOperationSequence (issue #25 item 3 — proving
       capture, not just allowlist decision logic, records a conditional's own test edge when it
       lives under a sequence's ".operations[i]" label rather than another conditional's
       ".match"/".nomatch" label). TC_SeqNestedTarget is dirtied directly by TestMod_Change.
       TestMod_Static wraps a cross-def PatchOperationConditional (test on TC_SeqNestedProbe) inside
       a PatchOperationSequence targeting TC_SeqNestedTarget. -->
  <ThingDef>
    <defName>TC_SeqNestedTarget</defName>
    <label>test seq-nested target</label>
  </ThingDef>

  <ThingDef>
    <defName>TC_SeqNestedProbe</defName>
    <label>test seq-nested probe</label>
    <probeFlag>yes</probeFlag>
  </ThingDef>

  <!-- CASE 9: PatchOperationConditional whose xpath-existence test target belongs to a THIRD,
       unrelated mod (docs/patch-operations-coverage.md's open "Open nuance" line under
       PatchOperationConditional). TC_ThirdModProbe is supplied ONLY by TestMod_ThirdMod, which is
       present for Run A and REMOVED before Run B — a pure mod-list change, not a content edit.
       TestMod_Static's conditional tests `Defs/ThingDef[defName="TC_ThirdModProbe"]` for mere
       existence and mutates TC_CondTarget accordingly:
         Run A (TestMod_ThirdMod present):  match branch fires   -> condThirdModTag=third-mod-present
         Run B (TestMod_ThirdMod removed):  nomatch branch fires -> condThirdModTag=third-mod-absent
       Neither TestMod_Static (the conditional owner) nor TestMod_Defs (TC_CondTarget's owner)
       changes between runs, and TC_CondTarget's OWN patch file never changes either — so nothing
       drives Seed 1/2 to mark it dirty via the mechanisms the earlier CASEs rely on. This isolates
       whether the allowlist/dirty-set pipeline has ANY mechanism connecting a conditional's
       xpath-existence read set to a third mod's add/remove. See expect-conditional-thirdmod. -->
  <ThingDef>
    <defName>TC_CondTarget</defName>
    <label>test third-mod conditional target</label>
  </ThingDef>
</Defs>
