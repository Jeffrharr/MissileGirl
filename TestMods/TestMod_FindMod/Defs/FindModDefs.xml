<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- TC_FM_Host: present in BOTH runs, file byte-identical across runs. Its tradeTags carries a
       tag that FindModPatch.xml conditionally strips (see that file for the branch). With the
       gate mod present (Run A) the resolved def has tradeTags [HostBase] (GatedTag stripped);
       with it absent (Run B) the strip never runs, so tradeTags stays [HostBase, GatedTag]. This
       def, its file, and the patch that mutates it never change between runs — so the only way
       the dirty set can cover the flip is the #40 fix feeding FindMod's resolved packageId(s)
       into the mayRequire index (the same Seed 6 the P4 fixture already exercises). -->
  <ThingDef>
    <defName>TC_FM_Host</defName>
    <label>findmod host</label>
    <tradeTags>
      <li>HostBase</li>
      <li>GatedTag</li>
    </tradeTags>
  </ThingDef>
</Defs>
