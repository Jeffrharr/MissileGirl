<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Run A for the expect-nested-conditional mode (CASE 7). The change vehicle adds a baseline
       changeTag to TC_NestedTarget via an exact-defName Add. The ONLY purpose is to give Run B
       something to Replace so TC_NestedTarget's patch file changes (Seed 2 / seedDefs), marking it
       dirty. Deliberately minimal — this mode isolates the nested conditional's BranchParentId
       resolution, so it touches no other test def. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TC_NestedTarget"]</xpath>
    <value>
      <changeTag>run-a</changeTag>
    </value>
  </Operation>
</Patch>
