<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Run B for the expect-op-kind mode (CASE 10). Replaces TC_OpKind_Target's changeTag value
       (run-a -> run-b), changing the changed mod's patch-file hash so the diagnostic seeds
       TC_OpKind_Target as dirty (Seed 2). TestMod_Static's PatchOperationFindMod (CASE 10) also
       produces TC_OpKind_Target, so RecomputeAllowlist must inspect that edge -- and since
       PatchOperationFindMod is not in SafeLeafOps, it declines with category "unknown-op-kind",
       proving the decline live rather than only offline (RecomputeAllowlistTests.FindMod_Declined). -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TC_OpKind_Target"]/changeTag</xpath>
    <value>
      <changeTag>run-b</changeTag>
    </value>
  </Operation>
</Patch>
