<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Run A for the expect-order-preserved mode (CASE 11). Adds a baseline changeTag to
       TC_Order_Source via an exact-defName Add, purely so Run B has something to Replace and
       TC_Order_Source's own patch file changes (Seed 2 / seedDefs), marking it dirty. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TC_Order_Source"]</xpath>
    <value>
      <changeTag>run-a</changeTag>
    </value>
  </Operation>
</Patch>
