<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Run A for the expect-test-op mode (CASE 15, issue #74). Adds a baseline changeTag to
       TC_TestGate_Target via an exact-defName Add, purely so Run B has something to Replace and
       TC_TestGate_Target's own patch file changes (Seed 2 / seedDefs), marking it dirty. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TC_TestGate_Target"]</xpath>
    <value>
      <changeTag>run-a</changeTag>
    </value>
  </Operation>
</Patch>
