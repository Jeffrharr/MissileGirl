<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Run A for the expect-scope-escape mode (CASE 12). Adds a baseline changeTag to
       TC_ScopeEscape_B via an exact-defName Add, purely so Run B has something to Replace and
       TC_ScopeEscape_B's own patch file changes (Seed 2 / seedDefs), marking it dirty. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TC_ScopeEscape_B"]</xpath>
    <value>
      <changeTag>run-a</changeTag>
    </value>
  </Operation>
</Patch>
