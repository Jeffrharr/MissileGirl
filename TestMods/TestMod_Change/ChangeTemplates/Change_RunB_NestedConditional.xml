<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Run B for the expect-nested-conditional mode (CASE 7). Replaces TC_NestedTarget's changeTag
       value (run-a -> run-b). The changed op type + value means the patch file hash differs from
       Run A, so the diagnostic seeds TC_NestedTarget as dirty (Seed 2). TC_NestedTarget's producing
       leaf op sits under TestMod_Static's outer (same-def) conditional's match branch, itself an
       inner (cross-def) conditional's match branch — the nested-parent shape this mode exercises.

       Note this is a plain LEAF op on the changed mod (not a container), so SubDocExpander does NOT
       fall back on its own: the allowlist's nested-conditional resolution is what must decline
       here, not the changed-mod container-op path. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TC_NestedTarget"]/changeTag</xpath>
    <value>
      <changeTag>run-b</changeTag>
    </value>
  </Operation>
</Patch>
