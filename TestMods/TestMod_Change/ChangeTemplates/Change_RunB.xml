<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Run B — the wide/changed version of TestMod_Change's patches.
       This file is copied to Patches/Change.xml before the second game launch.

       What changes vs run A and which test cases fire:
         CASE 1: PatchOperationAdd → PatchOperationReplace on TC_Identity's changeTag. Same
                 def, changed op type and value → seedDefs fires (patch file hash changed).
         CASE 3: Replace instead of Add on TC_SeqTarget → seedDefs fires; TC_SeqSibling must
                 be in the sub-doc for TestMod_Static's sequence to complete.
         CASE 2: xpath widened from defName="TC_Wildcard_A" to @ParentName="TC_WildcardBase"
                 → M2a wildcard re-test seeds TC_Wildcard_B and TC_Wildcard_C as newly matched.
         CASE 4: TC_WildcardBase (abstract) is the ancestor of the newly-matched concrete defs.
                 Inheritance fan-out from the abstract node should propagate dirtiness to its
                 children (they are already seeded directly by CASE 2 via M2a; this validates
                 that the closure also fires from the abstract base if it were independently
                 made dirty).
         CASE 5: adds conditionalTrigger to TC_Conditional → static mod's conditional now
                 takes the match branch → conditionalMatchTag is in the resolved def instead
                 of conditionalNoMatchTag. TC_Conditional is dirty because this patch file
                 changed. -->

  <!-- CASE 1 (run B): Replace the field value instead of adding it.
       The changed xpath + op type marks this patch file as changed → TC_Identity seeded
       via seedDefs (its patch is in the changed mod). -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TC_Identity"]/changeTag</xpath>
    <value>
      <changeTag>run-b</changeTag>
    </value>
  </Operation>

  <!-- CASE 3 (run B): Replace rather than Add on TC_SeqTarget; keeps it dirty.
       TestMod_Static's sequence (Add to TC_SeqSibling, then Add to TC_SeqTarget) must
       still complete — TC_SeqSibling must be present in any recompute sub-doc. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TC_SeqTarget"]/changeTag</xpath>
    <value>
      <changeTag>run-b</changeTag>
    </value>
  </Operation>

  <!-- CASE 2 (run B, WIDE): xpath now matches ALL TC_Wildcard_* defs via @ParentName.
       Run A only matched TC_Wildcard_A; this widen means TC_Wildcard_B and TC_Wildcard_C
       are newly matched → M2a wildcard re-test should seed them as dirty (flips=2 at
       minimum, plus TC_Wildcard_A which was already matched but now with a different
       op so it's also seeded). -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[@ParentName="TC_WildcardBase"]</xpath>
    <value>
      <wildcardTag>run-b</wildcardTag>
    </value>
  </Operation>

  <!-- CASE 5 trigger: adds conditionalTrigger to TC_Conditional so that TestMod_Static's
       PatchOperationConditional takes the match branch in this run.
       Without this, the match xpath finds nothing → nomatch fires → conditionalNoMatchTag.
       With this, the match xpath finds conditionalTrigger → match fires → conditionalMatchTag.
       TC_Conditional is dirty because this patch file changed (seedDefs via patch-mod change). -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TC_Conditional"]</xpath>
    <value>
      <conditionalTrigger>present</conditionalTrigger>
    </value>
  </Operation>
</Patch>
