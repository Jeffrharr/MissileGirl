<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the JoofTest.PatchOperationGenerative assembly for the apply-time-attribution live
       fixture. Output goes straight into the mod's Assemblies/ folder so RimWorld loads it. net481 +
       Krafs reference assemblies, same toolchain as the mod itself (build with the
       FrameworkPathOverride mono shim). Mirrors TestMod_P1's csproj. -->
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>JoofTestGenOp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutDir>../Assemblies/</OutDir>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" PrivateAssets="all" />
  </ItemGroup>

</Project>
