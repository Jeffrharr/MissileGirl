<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The generative op: at Apply time it news up a PatchOperationAdd (a child NOT in the static
       patch tree) and applies it, adding genTag to TC_GenTarget. Capture must attribute that
       dynamically-generated child to this op as joof.testharness.genop#0.generated[0] with sourceMod
       joof.testharness.genop (NOT unindexed#PatchOperationAdd), so unindexedEdgeCount stays 0 and the
       invisible-op risk is keyed to this mod. -->
  <Operation Class="JoofTest.PatchOperationGenerative">
    <xpath>Defs/ThingDef[defName="TC_GenTarget"]</xpath>
    <value>
      <genTag>generated</genTag>
    </value>
  </Operation>

  <!-- A /Defs-root ADD: the common real-world cause of documentPathFallbacks (mods adding a def via
       a patch). The matched node is the <Defs> root, which has no def identity, so capture keys it by
       document path ("Defs") — an unkeyable, unattributable-to-a-def producer. The edge's sourceMod
       is still this mod, so riskyMods must list joof.testharness.genop for this reason too. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
      <ThingDef>
        <defName>TC_GenAddedViaPatch</defName>
        <label>added to Defs root via patch</label>
      </ThingDef>
    </value>
  </Operation>
</Patch>
